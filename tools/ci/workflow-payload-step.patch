+      # F-5: the whole point. This inspects the finished APK — not the source
+      # tree — and fails the run if proot, its loader, its libraries, the rootfs
+      # or the on-phone toolchain are absent. Nothing downstream (artifact,
+      # ci-latest, Release) may run with a computer-less build.
+      - name: Gate — the APK must contain the computer
+        run: |
+          set -euo pipefail
+          found=0
+          for apk in app/build/outputs/apk/debug/app-debug.apk \
+                     app/build/outputs/apk/release/app-release.apk \
+                     app/build/outputs/apk/release/app-release-unsigned.apk; do
+            if [ -f "$apk" ]; then
+              python3 tools/forge/verify-apk-payload.py "$apk"
+              found=$((found + 1))
+            fi
+          done
+          [ "$found" -gt 0 ] || { echo "no APK was produced"; exit 1; }
+
