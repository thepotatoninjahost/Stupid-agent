diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index e7c0c5c..dd8d54d 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -140,6 +140,25 @@ jobs:
         env:
           ANDROID_HOME: /usr/local/lib/android/sdk
 
+      # F-5 (code review, 2026-11): the payload is git-ignored, so an APK can be
+      # built without a computer in it and only say so after install. This
+      # inspects the finished APK — not the source tree — and fails the run if
+      # proot, its loader, its libraries, the rootfs or the on-phone toolchain
+      # are absent, before anything is uploaded or made into a release.
+      - name: Gate — the APK must contain the computer
+        run: |
+          set -euo pipefail
+          found=0
+          for apk in app/build/outputs/apk/debug/app-debug.apk \
+                     app/build/outputs/apk/release/app-release.apk \
+                     app/build/outputs/apk/release/app-release-unsigned.apk; do
+            if [ -f "$apk" ]; then
+              python3 tools/forge/verify-apk-payload.py "$apk"
+              found=$((found + 1))
+            fi
+          done
+          [ "$found" -gt 0 ] || { echo "no APK was produced"; exit 1; }
+
       # --- Actions-storage quota hygiene -----------------------------------
       #
       # Free accounts get 500 MB of artifact storage SHARED across every
@@ -329,6 +348,6 @@ jobs:
 
             **First run:** Open Vorv → Files tab → grant a workspace folder → Setup tab → set LLM mode (cloud needs API key; local needs a one-time model download).
 
-            **Shell tool setup (optional):** install Termux (F-Droid/GitHub), run `termux-setup-storage` once, and grant Vorv the "Run commands in Termux" permission.
+            **Linux system:** Setup → Linux System → TEST. This build contains its own computer (proot + Alpine, no root, no Termux). TEST prints one line per stage — loader, proot, guest start, guest output — so a failure names the stage it failed at instead of just saying "no Linux".
           files: release/app-release.apk
           prerelease: true
