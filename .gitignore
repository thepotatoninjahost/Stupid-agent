*.iml
.gradle
/local.properties
/.idea
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
*.apk
*.aab
*.keystore

# v0.7.0 field finding #9: the DEBUG keystore is committed on purpose
(stable sideload signature — see app/build.gradle.kts). RELEASE keystores
stay ignored forever.

# Module build output (audit hygiene — was missing; build/ artifacts must never be committed)
/app/build/
.kotlin/

# Forge toolchain payload (~200 MB of pinned binaries) — rebuilt by
# tools/forge/fetch-runtime.sh from runtime-manifest.json, never committed.
/app/src/main/jniLibs/
/app/src/main/assets/forge/jvm/
/app/src/main/assets/forge/tools/

# The build template is source, not build output: it is the compiled manifest
# and launcher that every app built on the phone is packed into.
!/app/src/main/assets/forge/template.apk

# The source mirror the healer reads. The build generates it from
# app/src/main/java (syncSourceMirror) and packs it into the APK; committing it
# would be a second copy of the code that can drift. See app/build.gradle.kts.
/app/src/main/assets/source/

# The Debian root filesystem (~28 MB tar) — rebuilt by tools/forge/fetch-linux.sh
# from the digest-pinned Docker image, so it is never committed. The toolchain
# plan beside it is source, not payload, and must be committed: without it the
# app cannot know what to download (0.9.4 shipped without it and the phone said
# "this build carries no toolchain plan").
/app/src/main/assets/forge/linux/rootfs.tar
!/app/src/main/assets/forge/linux/toolchain.json

# screen recordings / media the user attaches
*.mp4
*.mov
*.webm

# python
__pycache__/
*.pyc
