<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Audit L-9: AgentService is an LLM-inference (compute) workload, not
         data sync. specialUse is the honest type for it; the subtype string
         below documents the actual purpose as Android 14+ requires. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required to be declarable so the user can grant it in Android Settings
         (Settings → Apps → Vorv → Permissions → Run commands in Termux).
         Termux's RUN_COMMAND mechanism only works when the caller holds this
         custom permission — it is a user-granted toggle, not an install grant. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!--
      Removed vs v0.5.x (audit supply-chain hygiene):
        RECEIVE_BOOT_COMPLETED — no BOOT_COMPLETED receiver exists in the app
             (WorkManager merges its own for its rescheduling receiver).
        WAKE_LOCK              — WorkManager merges its own; app code never holds one.
    -->

    <!-- Audit M-7: vorv.db (prompts, tool inputs/outputs, taught memories)
         used to ride Android cloud backup and device transfer while
         SECURITY.md promised data stays local. Local-first means local:
         allowBackup=false keeps ALL app data on the device. -->
    <application
        android:name=".VorvApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vorv"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Vorv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device LLM (NPU) inference while an agent task runs — a compute workload, not data synchronization" />
        </service>

        <!--
          WatchdogService — runs in a SEPARATE PROCESS (":watchdog").
          Survives main app crashes (even native SIGSEGV). Detects main
          process death, captures diagnostics from outside, orchestrates
          clean restart so the user sees the app come back instead of
          "Vorv has stopped".
        -->
        <service
            android:name=".watchdog.WatchdogService"
            android:process=":watchdog"
            android:exported="false" />
    </application>
</manifest>
