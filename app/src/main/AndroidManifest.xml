<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required to be declarable so the user can grant it in Android Settings
         (Settings → Apps → Vorv → Permissions → Run commands in Termux).
         Termux's RUN_COMMAND mechanism only works when the caller holds this
         custom permission — it is a user-granted toggle, not an install grant. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!--
      Removed vs v0.5.x (audit supply-chain hygiene):
        RECEIVE_BOOT_COMPLETED — no BOOT_COMPLETED receiver exists in the app
             (WorkManager merges its own for its rescheduling receiver).
        WAKE_LOCK              — WorkManager merges its own; app code never holds one.
    -->

    <!--
      Backup posture (audit M-7): conversation/tool-call data NEVER leaves the
      device. vorv.db (prompts, tool inputs/outputs, memory) is EXCLUDED from
      cloud backup AND device transfer — see res/xml/backup_rules.xml and
      res/xml/data_extraction_rules.xml. Only non-secret settings (DataStore)
      participate. SECURITY.md states this explicitly.
    -->
    <application
        android:name=".VorvApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vorv"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Vorv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          AgentService — a COMPUTE workload (audit L-9): the agent loop while
          a task runs. Declared as specialUse (the honest type for on-device
          compute) with the required property. If Play distribution is ever
          considered, document the use case in the Play console; for local
          installs this is simply the correct type (dataSync was not).
        -->
        <service
            android:name=".service.AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Exclusively user-initiated on-device AI agent task execution" />
        </service>

        <!--
          WatchdogService — runs in a SEPARATE PROCESS (":watchdog").
          Survives main app crashes (even native SIGSEGV). Detects main
          process death, captures diagnostics from outside, orchestrates
          clean restart so the user sees the app come back instead of
          "Vorv has stopped".

          M-6 (code review, 2026-11): foregroundServiceType="specialUse" so
          the watchdog can be started via startForegroundService() when the
          main process boots in the BACKGROUND (WorkManager reminder/crash
          report wake-ups) — the service promotes itself for milliseconds,
          demotes immediately, and keeps watching. Without this, background
          boots on Android 8+ silently started NO watchdog at all.
        -->
        <service
            android:name=".watchdog.WatchdogService"
            android:process=":watchdog"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Crash watchdog: monitors main process health and relaunches after crashes" />
        </service>
    </application>
</manifest>
